# Database connection (required)
DATABASE_URL=mysql://app_user:your-db-password@localhost:3306/your_db_name

# Session signing secret (required) — generate with: openssl rand -hex 32
JWT_SECRET=

# Admin login password (required) — used at /admin/login instead of the
# original Manus OAuth flow, since that only works inside Manus's platform.
ADMIN_PASSWORD=

# PayPal (required for the featured-placement checkout flow)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Google AdSense (optional) — powers the banner ad in AdBanner.tsx.
# Leave unset to show a subtle house placeholder that links to AdSense signup instead.
VITE_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_SLOT_ID=XXXXXXXXXX
